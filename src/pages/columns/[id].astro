---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import StatusChip from '../../components/StatusChip.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import { columns } from '../../data/columns';

export async function getStaticPaths() {
  return columns.map((column) => ({ params: { id: column.id }, props: { column } }));
}

const { column } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const relatedArticles = column.relatedArticleIds
  .map((id: string) => allArticles.find((article) => article.id === id))
  .filter(Boolean);
const actionHref = column.primaryAction.href.startsWith('http') ? column.primaryAction.href : `${base}${column.primaryAction.href}`;
const mode = column.kind === 'flagship' ? 'field' : column.id === 'tools' || column.id === 'os-lab' || column.id === 'diagnosis' ? 'cockpit' : 'paper';
---
<BaseLayout title={`${column.title} · 原力战略`} description={column.promise} mode={mode}>
  <section class:list={['column-hero', column.kind === 'flagship' && 'flagship-hero']}>
    <div class="container column-hero-grid">
      <div>
        <div class="column-kicker">
          <span class="eyebrow">{column.eyebrow}</span>
          <StatusChip status={column.status} label={column.statusLabel} />
        </div>
        <h1 class="display small">{column.title}</h1>
        {column.subtitle && <p class="subtitle">{column.subtitle}</p>}
        <blockquote>{column.question}</blockquote>
      </div>
      <aside class="column-brief yl-card yl-card--static">
        <p>{column.description}</p>
        <dl>
          <div><dt>更新节奏</dt><dd>{column.cadence}</dd></div>
          <div><dt>正典坐标</dt><dd>{column.modules.join(' · ')}</dd></div>
          <div><dt>当前状态</dt><dd>{column.statusLabel}</dd></div>
        </dl>
        <a class="button primary" href={actionHref}>{column.primaryAction.label}</a>
      </aside>
    </div>
    {column.kind === 'flagship' && (
      <div class="container motif" aria-hidden="true">
        <span>时代</span><i></i><span>选择</span><i></i><span>遗产</span>
      </div>
    )}
  </section>

  <section class="section">
    <div class="container focus-grid">
      <div>
        <p class="eyebrow">栏目承诺</p>
        <h2 class="section-title">这个栏目负责什么</h2>
        <p class="lead">{column.promise}</p>
      </div>
      <div>
        <p class="eyebrow">首批内容</p>
        <ol class="first-batch">{column.firstBatch.map((item: string) => <li>{item}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section related">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">已可阅读</p><h2 class="section-title">从现有内容开始</h2></div>
        <a href={`${base}/columns/`}>返回栏目总览 →</a>
      </div>
      {relatedArticles.length ? (
        <div class="grid cols-3">{relatedArticles.map((article) => <ArticleCard article={article} />)}</div>
      ) : (
        <div class="empty-state yl-card yl-card--static">
          <strong>该栏目目前处于{column.statusLabel}。</strong>
          <p>栏目协议和首批选题存在，不代表事实包、文章、真人行动或Outcome已经完成。正式内容通过证据与发布门后才会出现。</p>
        </div>
      )}
    </div>
  </section>

  <div class="container column-action">
    <ActionPanel
      eyebrow="行动与证据"
      title="内容发布不是终点。"
      description="更高验收是读者完成真实判断或行动，结果产生证据，证据改变文章、工具或规则候选，并在下一次任务开始前被明确加载。"
      href={actionHref}
      label={column.primaryAction.label}
    />
  </div>
</BaseLayout>

<style>
  .column-hero { position: relative; padding: var(--sp-10) 0 var(--sp-9); overflow: hidden; border-bottom: 1px solid var(--line); }
  .column-hero::after { content: ''; position: absolute; width: 420px; height: 420px; right: -120px; top: -180px; border: 1px solid var(--line); border-radius: 50%; box-shadow: 0 0 0 70px color-mix(in srgb, var(--line) 22%, transparent), 0 0 0 140px color-mix(in srgb, var(--line) 10%, transparent); opacity: .7; pointer-events: none; }
  .column-hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.35fr .75fr; gap: var(--sp-9); align-items: end; }
  .column-kicker { display: flex; align-items: center; gap: var(--sp-4); }
  .small { margin-top: var(--sp-5); font-size: clamp(3rem, 7vw, 5.8rem); }
  .subtitle { margin: calc(var(--sp-3) * -1) 0 var(--sp-7); color: var(--accent); font-family: var(--serif); font-size: clamp(1.35rem, 3vw, 2.2rem); }
  .column-hero blockquote { max-width: 860px; margin: var(--sp-7) 0 0; font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2.35rem); line-height: 1.38; }
  .column-brief > p { color: var(--ink2); }
  dl { margin: var(--sp-6) 0; }
  dl div { display: grid; grid-template-columns: 90px 1fr; gap: var(--sp-4); padding: var(--sp-3) 0; border-top: 1px solid var(--line); }
  dt { color: var(--ink3); font-size: .84rem; }
  dd { margin: 0; font-weight: 700; }
  .motif { position: relative; z-index: 2; display: grid; grid-template-columns: auto 1fr auto 1fr auto; gap: var(--sp-4); align-items: center; margin-top: var(--sp-9); color: var(--ink3); font-family: var(--mono); font-size: .78rem; letter-spacing: .12em; }
  .motif i { height: 1px; background: linear-gradient(90deg, var(--accent), var(--line)); }
  .focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-9); }
  .first-batch { margin: 0; padding: 0; list-style: none; counter-reset: item; }
  .first-batch li { counter-increment: item; padding: var(--sp-5) 0; border-bottom: 1px solid var(--line); color: var(--ink2); }
  .first-batch li::before { content: '0' counter(item); display: inline-block; width: 44px; color: var(--accent); font-family: var(--mono); font-weight: 760; }
  .related { background: color-mix(in srgb, var(--panel) 48%, transparent); }
  .empty-state { max-width: 760px; }
  .empty-state p { color: var(--ink2); }
  .column-action { padding-bottom: var(--sp-10); }
  @media (max-width: 820px) {
    .column-hero-grid, .focus-grid { grid-template-columns: 1fr; }
    .column-hero::after { opacity: .25; }
  }
</style>
