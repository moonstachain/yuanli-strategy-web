---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { columns } from '../../data/columns';

export async function getStaticPaths() {
  return columns.map((column) => ({ params: { id: column.id }, props: { column } }));
}

const { column } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const relatedArticles = column.relatedArticleIds
  .map((id: string) => allArticles.find((article) => article.id === id))
  .filter(Boolean);
const actionHref = column.primaryAction.href.startsWith('http')
  ? column.primaryAction.href
  : `${base}${column.primaryAction.href}`;
const statusClass = `status status-${column.status}`;
---
<BaseLayout title={`${column.title} · 原力战略`} description={column.promise}>
  <section class:list={['column-hero', column.kind === 'flagship' && 'flagship-hero']}>
    <div class="container column-hero-grid">
      <div>
        <div class="column-kicker">
          <span class="eyebrow">{column.eyebrow}</span>
          <span class={statusClass}>{column.statusLabel}</span>
        </div>
        <h1 class="display small">{column.title}</h1>
        {column.subtitle && <p class="subtitle">{column.subtitle}</p>}
        <blockquote>{column.question}</blockquote>
      </div>
      <aside class="column-brief">
        <p>{column.description}</p>
        <dl>
          <div><dt>更新节奏</dt><dd>{column.cadence}</dd></div>
          <div><dt>正典坐标</dt><dd>{column.modules.join(' · ')}</dd></div>
          <div><dt>当前状态</dt><dd>{column.statusLabel}</dd></div>
        </dl>
        <a class="button primary" href={actionHref}>{column.primaryAction.label}</a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container focus-grid">
      <div>
        <p class="eyebrow">栏目承诺</p>
        <h2 class="section-title">这个栏目负责什么</h2>
        <p class="lead">{column.promise}</p>
      </div>
      <div>
        <p class="eyebrow">首批内容</p>
        <ol class="first-batch">
          {column.firstBatch.map((item: string) => <li>{item}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section related">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">已可阅读</p>
          <h2 class="section-title">从现有内容开始</h2>
        </div>
        <a href={`${base}/columns/`}>返回栏目总览 →</a>
      </div>
      {relatedArticles.length ? (
        <div class="grid cols-3">
          {relatedArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <div class="empty-state">
          <strong>该栏目目前处于{column.statusLabel}。</strong>
          <p>栏目协议和首批选题存在，不代表历史事实包、文章、真人行动或Outcome已经完成。正式内容通过证据与发布门后才会出现在这里。</p>
        </div>
      )}
    </div>
  </section>

  <section class="section next-boundary">
    <div class="container boundary-card">
      <p class="eyebrow">行动与证据</p>
      <h2>内容发布不是终点。</h2>
      <p>这个栏目的更高验收是：读者完成真实判断或行动，结果产生证据，证据改变文章、工具或规则候选，并在下一次任务开始前被明确加载。</p>
      <a class="button" href={actionHref}>{column.primaryAction.label}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .column-hero { padding: 92px 0 68px; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 85% 20%, rgba(138,75,42,.15), transparent 32%); }
  .flagship-hero { background: var(--ink); color: var(--surface); }
  .column-hero-grid { display: grid; grid-template-columns: 1.35fr .75fr; gap: 64px; align-items: end; }
  .column-kicker { display: flex; align-items: center; gap: 14px; }
  .small { margin-top: 18px; font-size: clamp(3rem, 7vw, 5.8rem); }
  .subtitle { margin: -8px 0 30px; color: var(--accent); font-family: Georgia, "Noto Serif SC", serif; font-size: clamp(1.4rem, 3vw, 2.3rem); }
  .flagship-hero .subtitle { color: #e6b994; }
  blockquote { margin: 30px 0 0; max-width: 850px; font-family: Georgia, "Noto Serif SC", serif; font-size: clamp(1.45rem, 3vw, 2.35rem); line-height: 1.35; }
  .column-brief { padding: 26px; border: 1px solid var(--line); border-radius: 22px; background: rgba(255,253,248,.68); }
  .flagship-hero .column-brief { border-color: #50483f; background: rgba(255,255,255,.04); }
  .column-brief > p { color: var(--muted); }
  .flagship-hero .column-brief > p { color: #c8beb2; }
  dl { margin: 24px 0; }
  dl div { display: grid; grid-template-columns: 90px 1fr; gap: 14px; padding: 10px 0; border-top: 1px solid var(--line); }
  .flagship-hero dl div { border-color: #50483f; }
  dt { color: var(--muted); font-size: .85rem; }
  .flagship-hero dt { color: #a99f94; }
  dd { margin: 0; font-weight: 700; }
  .status { display: inline-flex; padding: 4px 9px; border-radius: 999px; font-size: .74rem; font-weight: 760; }
  .status-live { background: #dfead9; color: #36512f; }
  .status-execution-ready { background: #efe1c4; color: #6f4c16; }
  .status-planning-baseline { background: #ddd8d0; color: #58524b; }
  .flagship-hero .status-planning-baseline { background: #514a43; color: #f2e8de; }
  .focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .first-batch { margin: 8px 0 0; padding: 0; list-style: none; counter-reset: item; }
  .first-batch li { counter-increment: item; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .first-batch li::before { content: '0' counter(item); display: inline-block; width: 42px; color: var(--accent); font-weight: 760; }
  .related { background: rgba(234,216,199,.3); }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 28px; }
  .empty-state { max-width: 760px; padding: 28px; border: 1px dashed var(--line); border-radius: 20px; background: var(--surface); }
  .empty-state p { color: var(--muted); }
  .boundary-card { padding: 36px; border: 1px solid var(--line); border-radius: 24px; background: var(--surface); }
  .boundary-card h2 { font-family: Georgia, "Noto Serif SC", serif; font-size: 2rem; }
  .boundary-card p { max-width: 780px; color: var(--muted); }
  @media (max-width: 800px) {
    .column-hero-grid, .focus-grid { grid-template-columns: 1fr; gap: 36px; }
    .section-head { align-items: start; flex-direction: column; }
  }
</style>
