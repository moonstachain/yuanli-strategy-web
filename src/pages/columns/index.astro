---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusChip from '../../components/StatusChip.astro';
import { regularColumns, flagshipColumns } from '../../data/columns';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="栏目 · 原力战略" description="原力战略的常设栏目、旗舰系列与真实建设状态。" mode="paper">
  <section class="columns-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Editorial System</p>
        <h1 class="display small">不是堆更多内容，<br />而是建立会自我繁殖的栏目系统。</h1>
        <p class="lead">常设栏目负责持续观察、解释、诊断与行动；旗舰系列负责形成跨周期思想资产。所有入口都公开显示真实建设状态。</p>
      </div>
      <aside class="layer-map yl-card yl-card--static">
        <span>主题</span><i>→</i><span>栏目</span><i>→</i><span>战役</span><i>→</i><span>旗舰</span><i>→</i><span>正典回写</span>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">常设栏目</p><h2 class="section-title">持续运行的七个内容引擎</h2></div></div>
      <div class="grid cols-3 column-grid">
        {regularColumns.map((column, index) => (
          <a class="yl-card column-card" href={`${base}/columns/${column.id}/`}>
            <div class="card-top"><span class="meta">0{index + 1} · {column.eyebrow}</span><StatusChip status={column.status} label={column.statusLabel} /></div>
            <h3>{column.title}</h3>
            <p class="question">{column.question}</p>
            <p>{column.promise}</p>
            <span class="read">查看栏目 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="flagships" class="flagship-stage">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">旗舰系列</p><h2 class="section-title">时代、人物、企业与反例</h2><p class="lead">四个旗舰分别研究选择环境、命运临界点、商业物种和方法失效边界。</p></div></div>
      <div class="grid cols-2 flagship-grid">
        {flagshipColumns.map((column, index) => (
          <a class="flagship-card" href={`${base}/columns/${column.id}/`} data-index={`0${index + 1}`}>
            <div class="card-top"><span class="meta">{column.eyebrow}</span><StatusChip status={column.status} label={column.statusLabel} /></div>
            <h3>{column.title}</h3>
            <strong>{column.subtitle}</strong>
            <blockquote>{column.question}</blockquote>
            <p>{column.description}</p>
            <span class="read">进入观察场 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section boundary">
    <div class="container boundary-grid">
      <div><p class="eyebrow">治理边界</p><h2 class="section-title">这些不是同一层。</h2></div>
      <div class="boundary-chain">
        <p><strong>六大主题</strong><span>用户从哪里进入</span></p>
        <p><strong>常设栏目</strong><span>什么内容长期生产</span></p>
        <p><strong>媒体战役</strong><span>本阶段集中解释什么冲突</span></p>
        <p><strong>旗舰系列</strong><span>沉淀什么跨周期思想资产</span></p>
        <p><strong>A1—C4</strong><span>后台如何治理、检索与回写</span></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .columns-hero { padding: var(--sp-10) 0 var(--sp-9); }
  .hero-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: var(--sp-9); align-items: end; }
  .small { font-size: clamp(2.7rem, 6vw, 5.2rem); }
  .layer-map { display: grid; grid-template-columns: auto 1fr auto 1fr auto; gap: var(--sp-3); align-items: center; font-size: .8rem; }
  .layer-map span { padding: var(--sp-2); color: var(--ink2); }
  .layer-map i { color: var(--accent); font-style: normal; }
  .column-card { display: flex; min-height: 330px; flex-direction: column; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .column-card h3, .flagship-card h3 { margin: var(--sp-7) 0 var(--sp-2); font-family: var(--serif); font-size: 1.75rem; line-height: 1.25; }
  .column-card p { color: var(--ink2); }
  .column-card .question { color: var(--ink); font-weight: 720; }
  .read { margin-top: auto; padding-top: var(--sp-6); color: var(--accent); font-weight: 760; }
  .flagship-stage { padding: var(--sp-10) 0; background: linear-gradient(155deg, #0d2018, #091611); color: #f0e6d2; }
  .flagship-stage .eyebrow, .flagship-stage .read { color: #c9a961; }
  .flagship-stage .lead, .flagship-stage .meta { color: #cdbf9f; }
  .flagship-card { position: relative; display: flex; min-height: 430px; flex-direction: column; padding: var(--sp-8); overflow: hidden; border: 1px solid #304c39; border-radius: var(--r-l); background: rgba(20,48,31,.48); color: #f0e6d2; }
  .flagship-card::after { content: attr(data-index); position: absolute; right: var(--sp-6); bottom: -26px; color: rgba(201,169,97,.1); font-family: var(--serif); font-size: 9rem; }
  .flagship-card:hover { transform: translateY(var(--lift)); border-color: #8b6f2e; color: #f0e6d2; }
  .flagship-card strong { color: #c9a961; }
  .flagship-card blockquote { margin: var(--sp-7) 0 var(--sp-5); font-family: var(--serif); font-size: 1.5rem; line-height: 1.45; }
  .flagship-card p { color: #cdbf9f; }
  .boundary-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--sp-9); }
  .boundary-chain { border-left: 1px solid var(--line); padding-left: var(--sp-7); }
  .boundary-chain p { display: flex; justify-content: space-between; gap: var(--sp-6); margin: 0; padding: var(--sp-4) 0; border-bottom: 1px solid var(--line); }
  .boundary-chain span { color: var(--ink3); }
  @media (max-width: 820px) { .hero-grid, .boundary-grid { grid-template-columns: 1fr; } .layer-map { display: none; } .boundary-chain { border-left: 0; padding-left: 0; } }
</style>
