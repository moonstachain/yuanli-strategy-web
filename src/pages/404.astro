---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="页面未找到 · 原力战略">
  <section class="section">
    <div class="prose">
      <p class="eyebrow">404</p>
      <h1>这条链路还没有形成。</h1>
      <p>返回首页，重新选择你的进入位置。</p>
      <a class="button primary" href={`${base}/`}>返回首页</a>
    </div>
  </section>
</BaseLayout>
