---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { moduleNames } from '../../data/modules';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import ModuleCoordinate from '../../components/ModuleCoordinate.astro';
import ActionPanel from '../../components/ActionPanel.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const moduleName = article.data.module === 'ROOT' ? '总纲' : moduleNames[article.data.module];
const actionHref = article.data.nextAction?.href?.startsWith('http') ? article.data.nextAction.href : `${base}${article.data.nextAction?.href ?? '/articles/'}`;
const articleCenterHref = article.data.articleType === 'case' ? `${base}/articles/?type=case` : `${base}/articles/`;
const articleCenterLabel = article.data.articleType === 'case' ? '案例' : '文章';
const roleLabels = { hook: '时代钩子', evidence: '证据包', mechanism: '机制解释', action: '行动手柄', reflection: '复盘回写' };
const sourceLabels = { not_required: '无需外部来源', source_pack_ready: '来源包就绪', needs_sources: '来源待补', verified_sources: '来源已核验' };
---
<BaseLayout title={`${article.data.title} · 原力战略`} description={article.data.description} mode="paper" showReadingProgress={true}>
  <article>
    <div class="container article-context" aria-label="当前位置">
      <a href={`${base}/`}>首页</a><span>/</span><a href={articleCenterHref}>{articleCenterLabel}</a><span>/</span><span>{moduleName}</span>
      <a id="previous-location" class="previous-location" href={articleCenterHref} hidden>返回上一页 ↑</a>
    </div>

    <header class="article-hero">
      <div class="container hero-grid">
        <div>
          <div class="article-meta">
            <ModuleCoordinate module={article.data.module} name={moduleName} compact={true} />
            <EvidenceBadge level={article.data.evidenceLevel} />
            {article.data.contentRole && <span class="chip">{roleLabels[article.data.contentRole]}</span>}
            <span class="meta">{article.data.readingMinutes} 分钟</span>
          </div>
          <h1>{article.data.title}</h1>
          <p class="lead">{article.data.description}</p>
          {article.data.campaign && <p class="campaign-line">战役：{article.data.campaign}</p>}
        </div>
        <aside class="hero-note yl-card yl-card--compact yl-card--static">
          <p class="eyebrow">证据与阅读边界</p>
          <strong>区分事实、推论与行动。</strong>
          <p>本文的验收不是读完，而是能否形成一个更清晰的判断，并进入现实验证。</p>
          {article.data.sourceStatus && <small>{sourceLabels[article.data.sourceStatus]}</small>}
        </aside>
      </div>
    </header>

    <div class="container article-shell">
      <aside class="article-rail" aria-label="文章导航与坐标">
        <div class="rail-sticky">
          <p class="eyebrow">本文目录</p>
          <nav id="article-toc" class="toc"><span class="meta">目录正在生成</span></nav>
          <div class="rail-divider"></div>
          <p class="eyebrow evidence-title">证据纪律</p>
          <p class="rail-note">当前标记：<strong>{article.data.evidenceLevel}</strong>。反例、边界和未验证部分不应被包装成正典。</p>
        </div>
      </aside>

      <div>
        <div class="prose article-body" id="article-content"><Content /></div>
        {article.data.outcomeQuestion && (
          <section class="prose outcome-question" aria-labelledby="outcome-heading">
            <p class="eyebrow">Outcome Question</p>
            <h2 id="outcome-heading">如何知道这篇文章真的有用？</h2>
            <blockquote>{article.data.outcomeQuestion}</blockquote>
          </section>
        )}
        <div class="prose">
          <ActionPanel
            title={article.data.nextAction?.label ?? '把今天的判断变成一个现实行动'}
            description="原力文章的更高验收，是发生新的判断、行动、证据与回写候选。"
            href={actionHref}
            label={article.data.nextAction?.label ?? '开始这个行动'}
          />
          <div class="article-return-actions">
            <a href={articleCenterHref}>返回{articleCenterLabel}中心</a>
            <a href={`${base}/start/`}>找到我的起点</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <script is:inline>
    (() => {
      const article = document.getElementById('article-content');
      const toc = document.getElementById('article-toc');
      const progress = document.getElementById('reading-progress-bar');
      const previous = document.getElementById('previous-location');
      if (document.referrer) {
        try {
          const ref = new URL(document.referrer);
          if (ref.origin === location.origin && ref.pathname !== location.pathname && previous) {
            previous.href = ref.href;
            previous.hidden = false;
          }
        } catch {}
      }
      if (!article) return;
      const headings = [...article.querySelectorAll('h2, h3')];
      if (toc) {
        toc.innerHTML = '';
        if (!headings.length) toc.innerHTML = '<span class="meta">本文暂无分节目录</span>';
        else headings.forEach((heading, index) => {
          if (!heading.id) heading.id = `section-${index + 1}`;
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent || `第${index + 1}节`;
          link.dataset.level = heading.tagName.toLowerCase();
          toc.appendChild(link);
        });
      }
      const updateProgress = () => {
        if (!progress) return;
        const rect = article.getBoundingClientRect();
        const total = Math.max(article.offsetHeight - window.innerHeight * .55, 1);
        const read = Math.min(Math.max(-rect.top + window.innerHeight * .2, 0), total);
        progress.style.width = `${Math.round(read / total * 100)}%`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    })();
  </script>
</BaseLayout>

<style>
  .article-context { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); padding-top: var(--sp-5); color: var(--ink3); font-size: .78rem; }
  .article-context a:hover { color: var(--accent); }
  .previous-location { margin-left: auto; color: var(--accent); }
  .article-hero { padding: var(--sp-8) 0 var(--sp-9); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: var(--sp-9); align-items: end; }
  .article-hero h1 { max-width: 920px; margin: var(--sp-7) 0 var(--sp-5); font-family: var(--serif); font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.08; letter-spacing: -.04em; text-wrap: balance; }
  .article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3); }
  .campaign-line { margin: var(--sp-5) 0 0; color: var(--accent); font-size: .88rem; font-weight: 760; letter-spacing: .04em; }
  .hero-note strong { font-family: var(--serif); font-size: 1.2rem; }
  .hero-note p:last-of-type { margin-bottom: var(--sp-3); color: var(--ink2); font-size: .9rem; }
  .hero-note small { color: var(--ink3); }
  .article-shell { display: grid; grid-template-columns: var(--rail) minmax(0, var(--reading)); gap: var(--sp-9); justify-content: center; padding-top: var(--sp-9); padding-bottom: var(--sp-10); }
  .rail-sticky { position: sticky; top: calc(var(--header-h) + 52px); }
  .toc { display: grid; gap: var(--sp-2); }
  .toc :global(a) { padding: var(--sp-2) 0; border-bottom: 1px solid var(--line); color: var(--ink2); font-size: .86rem; line-height: 1.45; }
  .toc :global(a[data-level='h3']) { padding-left: var(--sp-4); color: var(--ink3); }
  .rail-divider { height: 1px; margin: var(--sp-7) 0; background: var(--line); }
  .rail-note { color: var(--ink3); font-size: .84rem; }
  .article-body { width: 100%; }
  .outcome-question { margin-top: var(--sp-9); padding-top: var(--sp-7); border-top: 1px solid var(--line); }
  .outcome-question h2 { margin-top: 0; }
  .article-return-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--sp-4); margin: var(--sp-7) 0; padding-top: var(--sp-5); border-top: 1px solid var(--line); color: var(--accent); font-weight: 720; }
  @media (max-width: 900px) {
    .hero-grid, .article-shell { grid-template-columns: 1fr; }
    .hero-note { display: block; margin-top: var(--sp-3); }
    .article-rail { order: -1; }
    .rail-sticky { position: static; padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--r-l); background: var(--panel-soft); }
    .toc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rail-divider, .rail-note, .evidence-title { display: none; }
  }
  @media (max-width: 560px) { .toc { grid-template-columns: 1fr; } .previous-location { width: 100%; margin-left: 0; } }
</style>
