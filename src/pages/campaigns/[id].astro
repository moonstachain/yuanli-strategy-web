---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import { campaigns } from '../../data/campaigns';

export async function getStaticPaths() {
  return campaigns.map((campaign) => ({ params: { id: campaign.id }, props: { campaign } }));
}

const { campaign } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const articles = campaign.articleIds
  .map((id: string) => allArticles.find((article) => article.id === id))
  .filter(Boolean);
const actionHref = campaign.action.href.startsWith('http') ? campaign.action.href : `${base}${campaign.action.href}`;
---
<BaseLayout title={`${campaign.title} · 原力战略`} description={campaign.promise} mode="field">
  <section class="campaign-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{campaign.eyebrow}</p>
        <h1>{campaign.title}</h1>
        <p class="subtitle">{campaign.subtitle}</p>
        <blockquote>{campaign.question}</blockquote>
      </div>
      <aside class="yl-card yl-card--static">
        <p>{campaign.description}</p>
        <dl>
          <div><dt>内容对象</dt><dd>{campaign.articleIds.length}篇</dd></div>
          <div><dt>结构</dt><dd>机制＋4正例＋1反例</dd></div>
          <div><dt>验收</dt><dd>形成自己的30天验证动作</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Campaign Route</p>
          <h2>按财富转化顺序阅读</h2>
        </div>
        <a href={`${base}/columns/`}>查看全部栏目 →</a>
      </div>
      <div class="route">
        <span>理解机制</span><i></i><span>观察正例</span><i></i><span>检验反例</span><i></i><span>进入行动</span>
      </div>
      {articles.length ? (
        <div class="grid cols-3 article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div>
      ) : (
        <div class="empty-state yl-card yl-card--static">
          <strong>专题内容仍在构建。</strong>
          <p>协议存在不代表文章、来源和真实Outcome已经完成。</p>
        </div>
      )}
    </div>
  </section>

  <div class="container campaign-action">
    <ActionPanel
      eyebrow="Action"
      title="不要只判断别人拥有什么财富。"
      description="把自己的事业放进时代、心智、空间、时间四个位置，只选择一个最薄弱环节，形成30天真实验证动作。"
      href={actionHref}
      label={campaign.action.label}
    />
  </div>
</BaseLayout>

<style>
  .campaign-hero { position: relative; overflow: hidden; padding: var(--sp-10) 0 var(--sp-9); border-bottom: 1px solid var(--line); }
  .campaign-hero::after { content: ''; position: absolute; width: 520px; height: 520px; right: -180px; top: -220px; border: 1px solid var(--line); border-radius: 50%; box-shadow: 0 0 0 80px color-mix(in srgb, var(--line) 20%, transparent), 0 0 0 160px color-mix(in srgb, var(--line) 8%, transparent); pointer-events: none; }
  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.25fr .75fr; gap: var(--sp-9); align-items: end; }
  h1 { margin: var(--sp-5) 0; font-family: var(--serif); font-size: clamp(3.2rem, 8vw, 6.6rem); line-height: 1; letter-spacing: -.05em; }
  .subtitle { max-width: 880px; color: var(--accent); font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2.2rem); }
  blockquote { max-width: 860px; margin: var(--sp-7) 0 0; font-family: var(--serif); font-size: clamp(1.55rem, 3vw, 2.45rem); line-height: 1.4; }
  dl { margin: var(--sp-6) 0 0; }
  dl div { display: grid; grid-template-columns: 80px 1fr; gap: var(--sp-4); padding: var(--sp-3) 0; border-top: 1px solid var(--line); }
  dt { color: var(--ink3); font-size: .82rem; }
  dd { margin: 0; font-weight: 700; }
  .route { display: grid; grid-template-columns: auto 1fr auto 1fr auto 1fr auto; gap: var(--sp-4); align-items: center; margin: var(--sp-7) 0; color: var(--ink3); font-family: var(--mono); font-size: .78rem; letter-spacing: .08em; }
  .route i { height: 1px; background: linear-gradient(90deg, var(--accent), var(--line)); }
  .article-grid { align-items: stretch; }
  .campaign-action { padding-bottom: var(--sp-10); }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .campaign-hero::after { opacity: .25; } }
  @media (max-width: 700px) { .route { grid-template-columns: 1fr; } .route i { display: none; } }
</style>
