---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-v2.css';
import StatusChip from '../components/StatusChip.astro';
import { themes } from '../data/themes';
import { modules } from '../data/modules';
import { columns, regularColumns, flagshipColumns } from '../data/columns';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const themeMap = Object.fromEntries(themes.map((theme) => [theme.id, theme.title]));
const evidenceMap = {
  hypothesis: '假设',
  derived: '派生',
  verified: '已验证',
  canon: '正典',
};
const articleTypeMap = {
  insight: '洞察',
  canon: '正典',
  case: '案例',
  tool: '工具',
  library: '书房',
};

const trilogyGroups = [
  { id: 'A', title: '第一部 · 原力资产', question: '我从哪里来', modules: modules.slice(0, 4) },
  { id: 'B', title: '第二部 · 原力创业', question: '我如何进入世界', modules: modules.slice(4, 8) },
  { id: 'C', title: '第三部 · 原力 OS', question: '我如何让下一次更强', modules: modules.slice(8, 12) },
];

const stats = [
  { n: '3', label: '部' },
  { n: '12', label: '正典模块' },
  { n: '7', label: '常设栏目' },
  { n: '4', label: '旗舰系列' },
  { n: '6', label: '用户主题' },
];

const ledger = [
  { label: '已发布文章', value: articles.length },
  { label: '已上线工具', value: 3 },
  { label: '已有正式内容的栏目', value: regularColumns.filter((item) => item.status === 'live').length },
  { label: '执行就绪栏目', value: regularColumns.filter((item) => item.status === 'execution-ready').length },
  { label: '策划基线', value: columns.filter((item) => item.status === 'planning-baseline').length },
];

const timeline = [
  { year: '1771', title: '工厂', echo: '机器开始重写劳动、时间与组织' },
  { year: '1844', title: '电报', echo: '信息第一次跑得比人更快' },
  { year: '1882', title: '电网', echo: '单品升级为通用基础设施' },
  { year: '1913', title: '流水线', echo: '效率成为商业模式' },
  { year: '1971', title: '芯片', echo: '通用可编程能力吞噬专用设备' },
  { year: '2022', title: '聊天框', echo: '语言成为新的人机操作界面' },
];

const tools = [
  { coord: 'A1', name: 'AI 清算卡', desc: '区分正在被平权的能力与仍会持续生成差异的线索。', href: '/tools/ai-clearance/' },
  { coord: 'B2', name: '贵任务与价值账户卡', desc: '把专家语言翻译成用户愿意理解、支付和转述的入口。', href: '/tools/category-hypothesis/' },
  { coord: 'C4', name: '项目回写卡', desc: '把一次任务的判断、证据和结果写回下一轮。', href: '/tools/project-backwrite/' },
];

const resolveHref = (href: string) => href.startsWith('http') ? href : `${base}${href}`;
---
<BaseLayout
  mode="field"
  title="原力战略 · AI时代事业进化系统"
  description="找到原力母体，把它放进时代与市场，再用原力 OS 让它持续自我繁殖。"
>
  <div class="symptom-strip" aria-label="按症状进入">
    <div class="container symptom-inner">
      <span class="micro-label">我卡在</span>
      <a href="#diagnosis">说不清自己独特在哪 <b>→ A1</b></a>
      <a href="#diagnosis">客户听不懂我的方法 <b>→ B2</b></a>
      <a href="#diagnosis">增长与交付都卡在本人 <b>→ C4</b></a>
      <a href="#diagnosis">项目做完什么也没留下 <b>→ C2</b></a>
    </div>
  </div>

  <section class="portal-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">YUANLI STRATEGY · 三部十二模块</p>
        <h1>把你的不可复制，<br />变成会复利的事业系统。</h1>
        <p class="hero-lead">AI 正在平权已经被标准化的能力。原力战略回答另外三个问题：什么持续从你身上生成差异，它如何进入时代与市场，以及如何让每一次结果使下一次更强。</p>

        <div class="life-chain" aria-label="原力战略生命链">
          <span>母体</span><i>›</i><span>原力资产</span><i>›</i><span>时代与市场</span><i>›</i><span>生意</span><i>›</i><span>文脉 · 大脑 · 地图 · 链路</span><i>›</i><span>母体升级</span>
        </div>

        <div class="hero-actions">
          <a class="button primary" href="#diagnosis">进入诊断室 · 自测卡点</a>
          <a class="button" href={`${base}/articles/what-is-yuanli-strategy-trilogy/`}>什么是原力战略三部曲</a>
        </div>

        <div class="stats-grid" aria-label="门户内容规模">
          {stats.map((stat) => <div><strong>{stat.n}</strong><span>{stat.label}</span></div>)}
        </div>
      </div>

      <aside class="hero-aside">
        <article class="judgment-card">
          <div class="card-kicker"><span>TODAY'S JUDGMENT</span><span>原力裁决</span></div>
          <blockquote>任务做完，不等于能力留下。项目结束后只剩收入、文件和疲惫，说明事业没有进化。</blockquote>
          <a href={`${base}/articles/c4-chain-turns-judgment-into-action/`}>C4 一条链路 · 继续阅读 →</a>
        </article>

        <article class="ledger-card">
          <div class="card-kicker"><span>BUILD LEDGER</span><span>真实建设状态</span></div>
          <div class="ledger-list">
            {ledger.map((row) => (
              <div class="ledger-row">
                <span>{row.label}</span>
                <i aria-hidden="true"><b style={`width:${Math.min(100, row.value * 12 + 18)}%`}></b></i>
                <strong>{row.value}</strong>
              </div>
            ))}
          </div>
          <p>页面存在只代表工程 Output；用户理解、行动与 Outcome 仍需真实证据。</p>
        </article>
      </aside>
    </div>
  </section>

  <section id="diagnosis" class="portal-section diagnosis-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">DIAGNOSIS · 先定位那一环</p><h2>先判断位置，再决定下一步做什么</h2></div>
        <a href={`${base}/columns/diagnosis/`}>进入完整诊断室 →</a>
      </div>
      <div class="diagnosis-grid">
        {trilogyGroups.map((group) => (
          <a class="diagnosis-panel" href={`${base}/columns/diagnosis/`}>
            <div class="panel-top"><span>{group.title}</span><span>{group.modules[0].id}—{group.modules[3].id}</span></div>
            <h3>{group.question}</h3>
            <p>{group.id === 'A' ? '我真正不可复制的生成源是什么？' : group.id === 'B' ? '时代为什么现在需要我，市场如何认得我？' : '如何让判断、知识与结果不再随项目消失？'}</p>
            <div class="module-dots">{group.modules.map((module) => <span>{module.id}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="canon" class="portal-section canon-ledger">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">CANON MATRIX · A1—C4</p><h2>三部不是三个主题，而是一条事业生命链</h2></div>
        <a href={`${base}/columns/canon/`}>进入原力正典 →</a>
      </div>
      <div class="trilogy-matrix">
        {trilogyGroups.map((group) => (
          <section class="trilogy-row">
            <header><span>{group.id}</span><div><strong>{group.title}</strong><small>{group.question}</small></div></header>
            <div class="module-row">
              {group.modules.map((module) => (
                <article>
                  <span>{module.id}</span>
                  <strong>{module.title}</strong>
                  <p>{module.question}</p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="portal-section columns-ledger">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">SEVEN COLUMNS · 常设生产协议</p><h2>七个栏目，不是七种版式，而是七种长期任务</h2></div>
        <a href={`${base}/columns/`}>查看栏目总览 →</a>
      </div>
      <div class="column-table" role="table" aria-label="七个常设栏目状态总账">
        <div class="column-head" role="row"><span>栏目</span><span>承诺</span><span>正典坐标</span><span>节奏</span><span>状态</span></div>
        {regularColumns.map((column) => (
          <a class="column-row" role="row" href={`${base}/columns/${column.id}/`}>
            <strong>{column.title}</strong>
            <span>{column.promise}</span>
            <span>{column.modules.join(' · ')}</span>
            <span>{column.cadence}</span>
            <StatusChip status={column.status} label={column.statusLabel} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="flagship" class="portal-section flagship-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">FLAGSHIP · 四个跨周期思想资产</p><h2>从300年时代现场，进入人物、企业与反例</h2></div>
        <a href={`${base}/columns/#flagships`}>查看全部旗舰 →</a>
      </div>

      <a class="timeline-stage" href={`${base}/columns/300-year-wave/`}>
        <div class="timeline-intro">
          <span>原力时代志</span>
          <h3>《300年康波》</h3>
          <p>以康波作为传播语言，以技术革命、资本安装、制度适配和社会扩散作为研究骨架。</p>
          <strong>进入双时间线 →</strong>
        </div>
        <div class="timeline" aria-label="300年康波关键时刻">
          {timeline.map((item) => (
            <div class="timeline-node">
              <span>{item.year}</span><i></i><strong>{item.title}</strong><small>{item.echo}</small>
            </div>
          ))}
        </div>
      </a>

      <div class="flagship-grid">
        {flagshipColumns.slice(1).map((column, index) => (
          <a class="flagship-card" href={`${base}/columns/${column.id}/`} data-index={`0${index + 2}`}>
            <div><span>{column.eyebrow}</span><StatusChip status={column.status} label={column.statusLabel} /></div>
            <h3>{column.title}</h3>
            <strong>{column.subtitle}</strong>
            <p>{column.question}</p>
            <small>{column.modules.join(' · ')}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="articles" class="portal-section article-ledger" data-article-ledger>
    <div class="container">
      <div class="section-heading article-heading">
        <div><p class="eyebrow">CANON LIBRARY · 已发布内容总账</p><h2>按主题、模块与证据等级检索</h2></div>
        <span id="article-result-count">共 {articles.length} 篇</span>
      </div>

      <div class="filter-toolbar">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="ledger-search" type="search" placeholder="搜索标题、贵任务、核心概念" /></label>
        <select id="module-filter" aria-label="按模块筛选">
          <option value="all">全部模块</option>
          <option value="ROOT">ROOT</option>
          {modules.map((module) => <option value={module.id}>{module.id} · {module.title}</option>)}
        </select>
        <select id="evidence-filter" aria-label="按证据等级筛选">
          <option value="all">全部证据</option>
          {Object.entries(evidenceMap).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
        <button id="reset-filters" type="button">清除筛选</button>
      </div>

      <div class="theme-filters" aria-label="按主题筛选">
        <button type="button" class="active" data-theme-value="all" aria-pressed="true">全部主题</button>
        {themes.map((theme) => <button type="button" data-theme-value={theme.id} aria-pressed="false">{theme.title}</button>)}
      </div>

      <div class="article-table">
        <div class="article-head"><span>文章与坐标</span><span>贵任务与概念</span><span>证据</span><span>下一步</span></div>
        {articles.map((article) => {
          const nextHref = resolveHref(article.data.nextAction.href);
          const searchText = [article.data.title, article.data.description, article.data.expensiveJob, ...article.data.coreConcepts].join(' ').toLowerCase();
          return (
            <article
              class="article-row"
              data-article-row
              data-theme={article.data.theme}
              data-module={article.data.module}
              data-evidence={article.data.evidenceLevel}
              data-search={searchText}
            >
              <div class="article-main">
                <div><span>{article.data.module}</span><small>{articleTypeMap[article.data.articleType]} · {article.data.publishedAt.toISOString().slice(0, 10)}</small></div>
                <a href={`${base}/articles/${article.id}/`}>{article.data.title}</a>
                <p>{article.data.description}</p>
              </div>
              <div class="article-job"><small>EXPENSIVE JOB</small><strong>{article.data.expensiveJob}</strong><span>{article.data.coreConcepts.join(' · ')}</span></div>
              <div class="article-evidence"><small>EVIDENCE</small><strong>{evidenceMap[article.data.evidenceLevel]}</strong><span>{themeMap[article.data.theme]} · {article.data.readingMinutes} 分钟</span></div>
              <div class="article-action"><small>NEXT ACTION</small><a href={nextHref}>{article.data.nextAction.label} →</a></div>
            </article>
          );
        })}
        <p id="article-empty" class="article-empty" hidden>没有匹配的内容。清除筛选，或从诊断室按症状进入。</p>
      </div>
    </div>
  </section>

  <section id="tools" class="portal-section tool-section">
    <div class="container tool-grid">
      <div>
        <p class="eyebrow">TOOLS · 阅读之后完成什么</p>
        <h2>三张工具卡，把理解变成第一份证据</h2>
        <p>草稿只保存在当前浏览器，不会自动上传。页面输出仍需进入真实行动、结果与回写。</p>
        <a class="button" href={`${base}/tools/`}>进入工具中心</a>
      </div>
      <div class="tool-list">
        {tools.map((tool) => (
          <a href={`${base}${tool.href}`}>
            <span>{tool.coord}</span><div><strong>{tool.name}</strong><p>{tool.desc}</p></div><small><i></i> live</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="portal-section theme-section">
    <div class="container theme-grid">
      {themes.map((theme) => (
        <a href={`${base}/themes/${theme.id}/`}>
          <strong>{theme.title}</strong><p>{theme.description}</p><small>{theme.question}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="portal-section final-action">
    <div class="container final-card">
      <div><p class="eyebrow">MINIMUM ACTION</p><h2>今天只做一件事：判断自己卡在哪一个模块</h2><p>做会自我繁殖的事，不做一次性的事。先留下第一张可被验证、推翻和回写的证据卡。</p></div>
      <div><a class="button primary" href="#diagnosis">开始定位</a><a class="button" href={`${base}/articles/what-is-yuanli-strategy-trilogy/`}>先读正典</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  const ledgerRoot = document.querySelector('[data-article-ledger]');
  if (ledgerRoot) {
    const rows = Array.from(ledgerRoot.querySelectorAll('[data-article-row]'));
    const search = ledgerRoot.querySelector('#ledger-search');
    const moduleFilter = ledgerRoot.querySelector('#module-filter');
    const evidenceFilter = ledgerRoot.querySelector('#evidence-filter');
    const reset = ledgerRoot.querySelector('#reset-filters');
    const count = ledgerRoot.querySelector('#article-result-count');
    const empty = ledgerRoot.querySelector('#article-empty');
    const themeButtons = Array.from(ledgerRoot.querySelectorAll('[data-theme-value]'));
    let activeTheme = 'all';

    const applyFilters = () => {
      const query = (search?.value || '').trim().toLowerCase();
      const moduleValue = moduleFilter?.value || 'all';
      const evidenceValue = evidenceFilter?.value || 'all';
      let visible = 0;

      rows.forEach((row) => {
        const matches =
          (activeTheme === 'all' || row.dataset.theme === activeTheme) &&
          (moduleValue === 'all' || row.dataset.module === moduleValue) &&
          (evidenceValue === 'all' || row.dataset.evidence === evidenceValue) &&
          (!query || (row.dataset.search || '').includes(query));
        row.hidden = !matches;
        if (matches) visible += 1;
      });

      if (count) count.textContent = `共 ${visible} 篇`;
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener('input', applyFilters);
    moduleFilter?.addEventListener('change', applyFilters);
    evidenceFilter?.addEventListener('change', applyFilters);
    themeButtons.forEach((button) => button.addEventListener('click', () => {
      activeTheme = button.dataset.themeValue || 'all';
      themeButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
    }));
    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      if (moduleFilter) moduleFilter.value = 'all';
      if (evidenceFilter) evidenceFilter.value = 'all';
      activeTheme = 'all';
      themeButtons.forEach((button) => {
        const active = button.dataset.themeValue === 'all';
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
    });
  }
</script>
