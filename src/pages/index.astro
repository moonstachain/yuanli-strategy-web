---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-v2.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const campaignArticles = articles.filter((article) => article.data.campaign === 'AI 正在蒸馏你').slice(0, 3);
const resolveHref = (href: string) => href.startsWith('http') ? href : `${base}${href}`;
const byIds = (ids: string[]) => ids.map((id) => articles.find((article) => article.id === id)).filter(Boolean);

const firstTimeArticles = byIds([
  'what-is-yuanli-strategy-trilogy',
  'ai-era-why-yuanli-strategy',
  'from-irreplaceable-to-compounding',
]);
const actionArticles = byIds([
  'ai-clearance-action-guide',
  'b2-category-is-choice-standard',
  'c4-chain-turns-judgment-into-action',
]);

const symptomPaths = [
  {
    index: '01',
    coordinate: 'A｜找到不可复制',
    title: '我说不清自己真正不可复制的是什么',
    symptoms: ['做过很多事，却无法提炼一条主线', '能力很多，但没有形成稳定辨识度', 'AI越强，越不知道自己还剩什么'],
    promise: '判断你最值得先验证A1、A2还是A3/A4。',
    href: '/start/?path=A',
    action: '找到我的原力',
  },
  {
    index: '02',
    coordinate: 'B｜让市场选择你',
    title: '用户认可我，却没有形成可放大的生意',
    symptoms: ['内容有人喜欢，却很少转化为付费', '客户觉得很好，却讲不清为什么选择你', '越增长越累，利润和控制权没有留下'],
    promise: '判断问题主要发生在借势、品类、模式还是壁垒。',
    href: '/start/?path=B',
    action: '诊断我的生意',
  },
  {
    index: '03',
    coordinate: 'C｜让事业持续进化',
    title: '团队和AI越来越多，事业仍然离不开我',
    symptoms: ['重要判断仍然等待创始人', 'AI产出越来越多，却越来越不像本人', '项目结束留下文件，下一次仍然从头开始'],
    promise: '找出文脉、大脑与链路中最先需要补的一环。',
    href: '/start/?path=C',
    action: '让创始人变成系统',
  },
];

const signals = [
  {
    tag: '能力',
    title: '可以被完整描述的能力，正在迅速成为公共算力。',
    implication: '个人价值需要从“会做什么”转向“为何持续产生不同判断”。',
  },
  {
    tag: '组织',
    title: '公司正在把个人经验提取为流程、知识库、Agent与Skill。',
    implication: '真正的主权不是藏住经验，而是保有持续生成新经验的母体。',
  },
  {
    tag: '内容',
    title: '内容供给趋近无限，可信解释与直接关系变得更稀缺。',
    implication: '个人品牌的核心从曝光量转向问题解释权和入口控制权。',
  },
];

const tools = [
  {
    coord: 'A1',
    title: '10分钟看清：你的哪些能力会被AI平权？',
    name: 'AI清算卡',
    forWhom: '适合觉得自己正在被AI替代、但说不清独特性的人',
    input: '3段真实经历，约10分钟',
    output: '一张表层能力清单＋一个母体候选',
    next: '用一个真实任务验证候选',
    href: '/tools/ai-clearance/',
    action: '开始10分钟清算',
  },
  {
    coord: 'B2',
    title: '把“我很专业”变成用户愿意选择的问题',
    name: '贵任务与价值账户卡',
    forWhom: '适合内容有人认可、业务却没有稳定选择入口的人',
    input: '一个目标用户＋一个真实购买场景',
    output: '贵任务、价值账户与品类假设',
    next: '找3位用户验证表达',
    href: '/tools/category-hypothesis/',
    action: '形成我的品类假设',
  },
  {
    coord: 'C4',
    title: '让这次项目成为下一次的起点',
    name: '项目回写卡',
    forWhom: '适合项目很多、但每次仍然从零开始的人',
    input: '一次真实项目的行动、证据与结果',
    output: 'Changed Rule候选＋下一次加载点',
    next: '在第二次任务开始前读取它',
    href: '/tools/project-backwrite/',
    action: '完成一次项目回写',
  },
];

const storyTracks = [
  { eyebrow: '第一次来', title: '先建立一张足够清楚的全景', articles: firstTimeArticles },
  { eyebrow: '正在发生', title: '跟随当前媒体战役进入现实变化', articles: campaignArticles },
  { eyebrow: '开始行动', title: '把一个判断变成可见资产', articles: actionArticles },
];
---
<BaseLayout
  mode="field"
  title="原力战略 · 从前沿认知到真实事业结果"
  description="看见正在改变事业的力量，找到最值得优先验证的一环，并完成第一次有价值的行动。"
>
  <div data-first-success-journey data-base={base}>
    <section class="media-hero">
      <div class="container media-hero-grid">
        <div class="hero-main">
          <p class="eyebrow">AI正在平权一切可以被描述、标准化和提取的能力</p>
          <h1>把你的不可复制，<br />变成会复利的事业系统。</h1>
          <p class="hero-lead">当经验、表达和执行逐渐成为公共能力，真正需要被找到和放大的，是你持续产生独特判断、作品与用户价值的生成源。</p>
          <div class="hero-actions">
            <a class="button primary" id="primary-diagnostic-cta" href={`${base}/start/`}>开始3分钟原力导航</a>
            <a class="hero-secondary" href={`${base}/articles/what-is-yuanli-strategy-trilogy/`}>第一次来，先看原力战略是什么 →</a>
          </div>
          <p class="hero-footnote">不测人格，不罗列优势。你将得到一个待验证的原力位置和一项现实行动。</p>
        </div>

        <aside class="judgment-panel">
          <p class="eyebrow">本周原力裁决</p>
          <blockquote>当你的经验可以被组织提取、复制和调用，真正不可替代的就不再是经验本身，而是你持续产生新判断的生成源。</blockquote>
          <a href={`${base}/articles/when-experience-becomes-skill/`}>阅读本周封面故事 →</a>
        </aside>
      </div>

      <div class="container">
        <aside class="resume-card" id="journey-resume" hidden aria-live="polite">
          <div>
            <span class="eyebrow">CONTINUE · 继续上次进度</span>
            <strong id="resume-title">系统记得你做到哪里</strong>
            <p id="resume-copy">继续完成上次导航或工具，不必重新寻找入口。</p>
          </div>
          <a class="button" id="resume-primary" href={`${base}/start/`}>继续上次行动</a>
        </aside>
      </div>
    </section>

    <section class="entry-section">
      <div class="container">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">START FROM SYMPTOMS · 从现实症状开始</p>
            <h2>你现在最像哪一种情况？</h2>
          </div>
          <p class="section-note">不要先选择模块。先选择正在反复发生的问题。</p>
        </div>
        <div class="symptom-entry-grid">
          {symptomPaths.map((item) => (
            <a class="symptom-card" href={resolveHref(item.href)}>
              <div class="symptom-head"><span>{item.index}</span><small>{item.coordinate}</small></div>
              <h3>{item.title}</h3>
              <ul>{item.symptoms.map((symptom) => <li>{symptom}</li>)}</ul>
              <p class="symptom-promise">你将得到：{item.promise}</p>
              <strong>{item.action} →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cover-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">COVER STORY · 本周封面</p>
            <h2>当你的经验被公司蒸馏成 Skill，你还剩下什么？</h2>
          </div>
          <span class="campaign-status">战役01 · AI正在蒸馏你</span>
        </div>

        <div class="cover-grid">
          <a class="cover-primary" href={`${base}/articles/when-experience-becomes-skill/`}>
            <span>HOOK · 时代钩子</span>
            <h3>经验变成组织资产之后，个人价值必须重新定价。</h3>
            <p>不是拒绝经验被复制，而是辨认哪些东西只属于过去，哪些能力仍能不断生成未来。</p>
            <strong>阅读封面文章 →</strong>
          </a>
          <div class="cover-stack">
            <a href={`${base}/articles/extractable-ability-vs-generative-source/`}>
              <span>MECHANISM · 机制</span>
              <h3>可提取能力，不等于生成性母体</h3>
              <p>区分技能、优势、品牌和真正持续生成差异的源头。</p>
            </a>
            <a href={`${base}/articles/ai-clearance-action-guide/`}>
              <span>ACTION · 手柄</span>
              <h3>用一张AI清算卡，完成第一次现实盘点</h3>
              <p>留下一个带置信度、反证条件和下一步实验的母体候选。</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="signal-section">
      <div class="container signal-layout">
        <div class="signal-intro">
          <p class="eyebrow">看懂时代 · 原力前哨</p>
          <h2>不追逐所有新闻，只追踪会改变长期选择的力量</h2>
          <p>每个信号必须回答：发生了什么、为什么重要、对谁影响最大、现在应改变什么判断。</p>
          <a class="text-link" href={`${base}/columns/observation/`}>查看全部前哨内容 →</a>
        </div>
        <div class="signal-list">
          {signals.map((signal, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><small>{signal.tag}</small><h3>{signal.title}</h3><p>{signal.implication}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tools-section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">完成一项行动</p><h2>工具先说你会得到什么</h2></div>
          <a class="text-link" href={`${base}/tools/`}>进入工具中心 →</a>
        </div>
        <div class="tool-outcome-grid">
          {tools.map((tool) => (
            <a class="tool-outcome-card" href={resolveHref(tool.href)}>
              <div class="tool-title-row"><span>{tool.coord}</span><small>{tool.name}</small></div>
              <h3>{tool.title}</h3>
              <dl>
                <div><dt>适合谁</dt><dd>{tool.forWhom}</dd></div>
                <div><dt>需要什么</dt><dd>{tool.input}</dd></div>
                <div><dt>得到什么</dt><dd>{tool.output}</dd></div>
                <div><dt>接下来</dt><dd>{tool.next}</dd></div>
              </dl>
              <strong>{tool.action} →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="story-tracks-section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">THREE READING TRACKS</p><h2>首页不再展示文章总账，只提供三条清楚路径</h2></div>
          <a class="text-link" href={`${base}/articles/`}>搜索与筛选全部文章 →</a>
        </div>
        <div class="story-track-grid">
          {storyTracks.map((track) => (
            <article class="story-track">
              <span>{track.eyebrow}</span>
              <h3>{track.title}</h3>
              <div>
                {track.articles.map((article) => article && (
                  <a href={`${base}/articles/${article.id}/`}>
                    <small>{article.data.module} · {article.data.readingMinutes}分钟</small>
                    <strong>{article.data.title}</strong>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="species-section">
      <div class="container species-grid">
        <div class="species-copy">
          <p class="eyebrow">本月主展 · 原力商业物种志</p>
          <h2>一家公司如何通过一个关键选择，成为不同于同行的新物种？</h2>
          <p>不写成功学摘要。沿时代窗口、创始人原力、用户贵问题、品类、三条链路、四种控制权与OS遗传，拆解商业生命体。</p>
          <a class="button" href={`${base}/columns/business-species/`}>进入商业物种志</a>
        </div>
        <div class="species-candidates">
          <article><span>候选01</span><h3>丰田</h3><p>判断如何进入生产系统，而不是永远停留在管理者脑中。</p></article>
          <article><span>候选02</span><h3>宜家</h3><p>用户劳动如何被重新配置，并成为商业模式的一部分。</p></article>
          <article><span>候选03</span><h3>Costco</h3><p>低毛利如何转化为信任、留存与长期控制权。</p></article>
        </div>
      </div>
    </section>

    <section class="canon-section">
      <div class="container canon-grid">
        <div class="canon-intro">
          <p class="eyebrow">诊断之后的地图</p>
          <h2>用户问题在前，正典坐标在后</h2>
          <p>首页只显示三个事业阶段。需要深入时，再展开A1—C4完整地图、边界与证据。</p>
          <a class="text-link" href={`${base}/columns/canon/`}>查看三部十二模块完整地图 →</a>
        </div>
        <div class="canon-cards">
          <article><span>A · 自我</span><h3>找到不可复制</h3><p>A1—A4｜发现、回到、获得并显化持续生成差异的原力母体。</p></article>
          <article><span>B · 世界</span><h3>让市场选择你</h3><p>B1—B4｜让差异进入时代、用户、品类、模式与控制权。</p></article>
          <article><span>C · 时间</span><h3>让事业持续进化</h3><p>C1—C4｜让文脉、证据、地图、行动与结果持续递归回写。</p></article>
        </div>
      </div>
    </section>

    <section class="outcome-section">
      <div class="container outcome-grid">
        <div>
          <p class="eyebrow">证据与边界</p>
          <h2>没有真实结果的内容，不写成成功案例</h2>
        </div>
        <div class="outcome-chain">
          <span>看见我</span><i>→</i><span>理解我</span><i>→</i><span>定位我</span><i>→</i><span>完成一次</span><i>→</i><span>记住进度</span>
        </div>
        <div class="truth-card">
          <strong>当前真实状态</strong>
          <p>媒体化首页、3分钟导航与本地续接已经进入工程验证；首次理解效率、入口选择正确率、工具完成率和回访连续性仍为NOT_RUN。</p>
          <a href={`${base}/status/`}>查看透明建设账 →</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const LAST_KEY = 'yuanli-journey:last';
      const NAV_KEY = 'yuanli-navigation:v0.1';
      const root = document.querySelector('[data-first-success-journey]');
      const base = root?.dataset.base || '';
      const card = document.getElementById('journey-resume');
      const title = document.getElementById('resume-title');
      const copy = document.getElementById('resume-copy');
      const action = document.getElementById('resume-primary');

      let last = null;
      try { last = JSON.parse(localStorage.getItem(LAST_KEY) || 'null'); } catch { localStorage.removeItem(LAST_KEY); }

      if (!last) {
        try {
          const navigation = JSON.parse(localStorage.getItem(NAV_KEY) || 'null');
          if (navigation && Array.isArray(navigation.answers) && navigation.answers.some((value) => value !== null)) {
            last = { type: 'navigation', label: '未完成的3分钟原力导航', href: `${base}/start/` };
          }
        } catch { localStorage.removeItem(NAV_KEY); }
      }

      if (last && card && title && copy && action) {
        card.hidden = false;
        title.textContent = last.label || '继续上次进度';
        copy.textContent = last.type === 'tool'
          ? '你的工具草稿仍保存在当前浏览器，可以从上次位置继续。'
          : '你的导航位置仍保存在当前浏览器，可以继续完成或进入推荐行动。';
        action.href = last.actionHref || last.href || `${base}/start/`;
        action.textContent = last.actionHref ? '进入推荐行动' : '继续上次进度';
      }
    })();
  </script>
</BaseLayout>
