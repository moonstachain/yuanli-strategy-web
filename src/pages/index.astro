---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-v2.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const campaignArticles = articles.filter((article) => article.data.campaign === 'AI 正在蒸馏你');
const latestArticles = articles.slice(0, 6);
const resolveHref = (href: string) => href.startsWith('http') ? href : `${base}${href}`;

const entryPaths = [
  {
    index: '01',
    eyebrow: '看懂时代',
    title: '什么正在贬值，什么正在升值？',
    description: '从AI、组织、职业、媒介与商业模式的变化中，识别新的选择环境。',
    href: '/columns/observation/',
    action: '进入原力前哨',
  },
  {
    index: '02',
    eyebrow: '找到原力',
    title: '我真正不可复制的生成源是什么？',
    description: '区分已经被标准化的能力，与持续从生命经验、品味和承诺中生成差异的母体。',
    href: '/tools/ai-clearance/',
    action: '完成AI清算',
  },
  {
    index: '03',
    eyebrow: '建成系统',
    title: '如何让事业不再只依赖本人？',
    description: '把判断、证据、行动与结果写回文脉、大脑、地图和链路，让下一次从更高起点开始。',
    href: '/columns/os-lab/',
    action: '进入OS实验室',
  },
];

const signals = [
  {
    tag: '能力',
    title: '可以被完整描述的能力，正在迅速成为公共算力。',
    implication: '个人价值需要从“会做什么”转向“为何持续产生不同判断”。',
  },
  {
    tag: '组织',
    title: '公司正在把个人经验提取为流程、知识库、Agent与Skill。',
    implication: '真正的主权不是藏住经验，而是保有持续生成新经验的母体。',
  },
  {
    tag: '内容',
    title: '内容供给趋近无限，可信解释与直接关系变得更稀缺。',
    implication: '个人品牌的核心从曝光量转向问题解释权和入口控制权。',
  },
];

const tools = [
  { coord: 'A1', title: 'AI清算卡', description: '判断哪些能力正在被平权，哪些线索仍持续生成差异。', href: '/tools/ai-clearance/' },
  { coord: 'B2', title: '贵任务与价值账户卡', description: '把专家语言翻译为用户愿意理解、支付与转述的问题。', href: '/tools/category-hypothesis/' },
  { coord: 'C4', title: '项目回写卡', description: '让一次任务留下证据、规则与下一次可调用的资产。', href: '/tools/project-backwrite/' },
];
---
<BaseLayout
  mode="field"
  title="原力战略 · AI时代的前沿战略媒体与事业进化实验场"
  description="提前看见正在改变事业的力量，把变化转化为判断，把判断转化为行动，把行动沉淀成会复利的事业系统。"
>
  <section class="media-hero">
    <div class="container media-hero-grid">
      <div class="hero-main">
        <p class="eyebrow">YUANLI STRATEGY · SIGNAL TO OUTCOME</p>
        <h1>AI正在重写每一种职业。<br />你如何把不可复制，变成会复利的事业？</h1>
        <p class="hero-lead">提前看见正在改变事业的力量，把变化转化为判断，把判断转化为行动，再把真实结果写回下一轮。</p>
        <div class="hero-actions">
          <a class="button primary" href={`${base}/articles/when-experience-becomes-skill/`}>阅读本周封面故事</a>
          <a class="button" href={`${base}/tools/ai-clearance/`}>完成5分钟AI清算</a>
        </div>
        <p class="hero-footnote">为企业家、专家型创业者与高认知个体而建。不是热点聚合，也不是课程目录。</p>
      </div>

      <aside class="judgment-panel">
        <p class="eyebrow">本周原力裁决</p>
        <blockquote>当你的经验可以被组织提取、复制和调用，真正不可替代的就不再是经验本身，而是你持续产生新判断的生成源。</blockquote>
        <div class="judgment-chain"><span>Signal</span><i>→</i><span>Judgment</span><i>→</i><span>Action</span><i>→</i><span>Outcome</span></div>
        <a href={`${base}/columns/observation/`}>进入原力前哨 →</a>
      </aside>
    </div>
  </section>

  <section class="cover-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">COVER STORY · 首个认知行动包</p>
          <h2>当你的经验被公司蒸馏成 Skill，你还剩下什么？</h2>
        </div>
        <span class="campaign-status">战役01 · AI正在蒸馏你</span>
      </div>

      <div class="cover-grid">
        <a class="cover-primary" href={`${base}/articles/when-experience-becomes-skill/`}>
          <span>HOOK · 时代钩子</span>
          <h3>经验变成组织资产之后，个人价值必须重新定价。</h3>
          <p>不是拒绝经验被复制，而是辨认哪些东西只属于过去，哪些能力仍能不断生成未来。</p>
          <strong>阅读封面文章 →</strong>
        </a>
        <div class="cover-stack">
          <a href={`${base}/articles/extractable-ability-vs-generative-source/`}>
            <span>MECHANISM · 机制</span>
            <h3>可提取能力，不等于生成性母体</h3>
            <p>区分技能、优势、品牌和真正持续生成差异的源头。</p>
          </a>
          <a href={`${base}/articles/ai-clearance-action-guide/`}>
            <span>ACTION · 手柄</span>
            <h3>用一张AI清算卡，完成第一次现实盘点</h3>
            <p>留下一个带置信度、反证条件和下一步实验的母体候选。</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="entry-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <div><p class="eyebrow">THREE ENTRANCES</p><h2>不要先学体系，先解决你正在面对的问题</h2></div>
      </div>
      <div class="entry-grid">
        {entryPaths.map((item) => (
          <a class="entry-card" href={resolveHref(item.href)}>
            <div><span>{item.index}</span><small>{item.eyebrow}</small></div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <strong>{item.action} →</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="signal-section">
    <div class="container signal-layout">
      <div class="signal-intro">
        <p class="eyebrow">FORCE SIGNALS · 原力信号</p>
        <h2>我们不追逐所有新闻，只追踪会改变长期选择的力量</h2>
        <p>每个信号必须回答：发生了什么、为什么重要、对谁影响最大、现在应改变什么判断。</p>
        <a class="text-link" href={`${base}/columns/observation/`}>查看全部前哨内容 →</a>
      </div>
      <div class="signal-list">
        {signals.map((signal, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small>{signal.tag}</small><h3>{signal.title}</h3><p>{signal.implication}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="species-section">
    <div class="container species-grid">
      <div class="species-copy">
        <p class="eyebrow">BUSINESS SPECIES · 原力商业物种志</p>
        <h2>一家公司如何通过一个关键选择，成为不同于同行的新物种？</h2>
        <p>不写成功学摘要。沿着时代窗口、创始人原力、用户贵问题、品类、三条链路、四种控制权与OS遗传，拆解商业生命体。</p>
        <a class="button" href={`${base}/columns/business-species/`}>进入商业物种志</a>
      </div>
      <div class="species-candidates">
        <article><span>候选01</span><h3>丰田</h3><p>判断如何进入生产系统，而不是永远停留在管理者脑中。</p></article>
        <article><span>候选02</span><h3>宜家</h3><p>用户劳动如何被重新配置，并成为商业模式的一部分。</p></article>
        <article><span>候选03</span><h3>Costco</h3><p>低毛利如何转化为信任、留存与长期控制权。</p></article>
      </div>
    </div>
  </section>

  <section class="outcome-section">
    <div class="container outcome-grid">
      <div>
        <p class="eyebrow">FROM READING TO OUTCOME</p>
        <h2>内容的终点不是“懂了”，而是现实中发生了新的选择</h2>
      </div>
      <div class="outcome-chain">
        <span>看见变化</span><i>→</i><span>形成判断</span><i>→</i><span>完成行动</span><i>→</i><span>观察结果</span><i>→</i><span>改变下一次</span>
      </div>
      <div class="truth-card">
        <strong>当前真实状态</strong>
        <p>工具与内容已经上线；真人诊断、30天回访、Validated案例与第二任务复用仍需真实运行证据。</p>
        <a href={`${base}/status/`}>查看透明建设账 →</a>
      </div>
    </div>
  </section>

  <section class="tools-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">ACTION TOOLS</p><h2>读完之后，至少留下一个可见资产</h2></div>
        <a class="text-link" href={`${base}/tools/`}>进入工具中心 →</a>
      </div>
      <div class="tool-grid">
        {tools.map((tool) => (
          <a class="tool-card" href={resolveHref(tool.href)}>
            <span>{tool.coord}</span><h3>{tool.title}</h3><p>{tool.description}</p><strong>开始行动 →</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="canon-section">
    <div class="container canon-grid">
      <div class="canon-intro">
        <p class="eyebrow">THE CANON BEHIND THE MEDIA</p>
        <h2>前台从事件进入，后台由三部十二模块保证不说散</h2>
        <p>原力战略不是三个并列话题，而是一条事业生命链：差异从哪里产生，如何被世界接受，怎样跨时间积累。</p>
        <a class="text-link" href={`${base}/columns/canon/`}>深入原力正典 →</a>
      </div>
      <div class="canon-cards">
        <article><span>A · 自我</span><h3>原力资产</h3><p>发现、回到、获得并显化持续生成差异的原力母体。</p></article>
        <article><span>B · 世界</span><h3>原力创业</h3><p>把差异价值放进时代、用户、品类、模式与控制权。</p></article>
        <article><span>C · 时间</span><h3>原力OS</h3><p>让文脉、证据、地图、行动与结果持续递归回写。</p></article>
      </div>
    </div>
  </section>

  <section class="latest-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">LATEST</p><h2>最新文章</h2></div>
        <a class="text-link" href={`${base}/articles/`}>查看全部文章 →</a>
      </div>
      <div class="latest-grid">
        {latestArticles.map((article) => (
          <a class="latest-card" href={`${base}/articles/${article.id}/`}>
            <div><span>{article.data.module}</span><small>{article.data.contentRole ?? article.data.articleType}</small></div>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <strong>{article.data.readingMinutes}分钟 · 阅读 →</strong>
          </a>
        ))}
      </div>
      {campaignArticles.length === 0 && <p class="meta">首个战役内容正在进入发布门。</p>}
    </div>
  </section>
</BaseLayout>
