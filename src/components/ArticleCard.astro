---
import EvidenceBadge from './EvidenceBadge.astro';
const { article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = article.data;
---
<a class="yl-card article-card" href={`${base}/articles/${article.id}/`}>
  <div class="card-top">
    <span class="chip">{data.module}</span>
    <EvidenceBadge level={data.evidenceLevel} />
  </div>
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  <div class="card-foot">
    <span class="meta">{data.readingMinutes} 分钟</span>
    <span class="read">继续阅读 →</span>
  </div>
</a>
<style>
  .article-card { display: flex; min-height: 280px; flex-direction: column; }
  .card-top, .card-foot { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); }
  h3 { margin: var(--sp-7) 0 var(--sp-3); font-family: var(--serif); font-size: 1.48rem; line-height: 1.34; text-wrap: balance; }
  p { margin: 0; color: var(--ink2); }
  .card-foot { margin-top: auto; padding-top: var(--sp-7); }
  .read { color: var(--accent); font-weight: 760; }
</style>
