---
const { eyebrow = '下一步不是继续阅读', title, description, href, label = '开始这个行动' } = Astro.props;
---
<section class="action-panel yl-card yl-card--panel">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  <slot />
  <a class="button primary" href={href}>{label}</a>
</section>
<style>
  .action-panel { margin-top: var(--sp-9); }
  .action-panel h2 { margin: var(--sp-2) 0 var(--sp-3); font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.2; }
  .action-panel > p:not(.eyebrow) { max-width: 760px; color: var(--ink2); }
  .action-panel .button { margin-top: var(--sp-4); }
</style>
