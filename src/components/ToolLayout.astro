---
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, module, description, principle } = Astro.props;
---
<BaseLayout title={`${title} · 原力战略工具`} description={description} mode="cockpit">
  <section class="tool-hero">
    <div class="container tool-hero-grid">
      <div>
        <span class="chip">{module} · 行动工具</span>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
      <blockquote>{principle}</blockquote>
    </div>
  </section>

  <section class="container tool-layout">
    <aside class="tool-note yl-card yl-card--static">
      <p class="eyebrow">本地工作协议</p>
      <h2>先形成假设，再进入现实检验</h2>
      <p>输入只保存在当前浏览器的本地存储，不自动上传。不要填写客户姓名、密钥或未经授权的经营真账。</p>
      <div class="save-state" aria-live="polite">
        <div class="state-row"><span>完成进度</span><strong id="tool-progress-label">0%</strong></div>
        <div class="progress-track" aria-hidden="true"><span id="tool-progress-bar"></span></div>
        <p id="autosave-status" class="meta">尚未产生本地草稿</p>
      </div>
      <button class="button quiet" type="button" id="clear-local-draft">清除本地草稿</button>
    </aside>

    <div class="tool-main">
      <slot />
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('.tool-form');
      if (!form) return;
      const key = `yuanli-tool:${location.pathname}`;
      const controls = [...form.querySelectorAll('input, textarea, select')].filter((el) => el.id && el.type !== 'button' && el.type !== 'submit' && el.type !== 'reset');
      const status = document.getElementById('autosave-status');
      const label = document.getElementById('tool-progress-label');
      const bar = document.getElementById('tool-progress-bar');
      const clear = document.getElementById('clear-local-draft');

      const updateProgress = () => {
        const filled = controls.filter((el) => String(el.value || '').trim()).length;
        const percent = controls.length ? Math.round(filled / controls.length * 100) : 0;
        if (label) label.textContent = `${percent}%`;
        if (bar) {
          bar.style.setProperty('--progress', `${percent}%`);
          bar.style.width = `${percent}%`;
        }
      };

      const save = () => {
        const payload = Object.fromEntries(controls.map((el) => [el.id, el.value]));
        localStorage.setItem(key, JSON.stringify(payload));
        if (status) status.textContent = `已于 ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} 保存到本机`;
        updateProgress();
      };

      try {
        const payload = JSON.parse(localStorage.getItem(key) || '{}');
        let restored = false;
        controls.forEach((el) => {
          if (Object.prototype.hasOwnProperty.call(payload, el.id)) {
            el.value = payload[el.id];
            restored = restored || Boolean(String(payload[el.id]).trim());
          }
        });
        if (restored && status) status.textContent = '已恢复当前浏览器中的本地草稿';
      } catch {
        localStorage.removeItem(key);
      }

      controls.forEach((el) => el.addEventListener('input', save));
      form.addEventListener('reset', () => {
        setTimeout(() => {
          localStorage.removeItem(key);
          if (status) status.textContent = '表单与本地草稿已清空';
          updateProgress();
        });
      });
      clear?.addEventListener('click', () => {
        localStorage.removeItem(key);
        if (status) status.textContent = '本地草稿已清除；当前页面输入仍保留';
      });
      updateProgress();
    })();
  </script>
</BaseLayout>

<style is:global>
  .tool-hero { padding: var(--sp-10) 0 var(--sp-8); border-bottom: 1px solid var(--line); }
  .tool-hero-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: var(--sp-9); align-items: end; }
  .tool-hero h1 { margin: var(--sp-5) 0 var(--sp-4); font-family: var(--serif); font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.08; }
  .tool-hero blockquote { margin: 0; padding: var(--sp-7); border: 1px solid var(--line); border-radius: var(--r-l); background: var(--panel); color: var(--ink); font-family: var(--serif); font-size: 1.2rem; line-height: 1.6; }
  .tool-layout { display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: var(--sp-7); padding-top: var(--sp-8); padding-bottom: var(--sp-10); align-items: start; }
  .tool-note { position: sticky; top: calc(var(--header-h) + var(--sp-5)); }
  .tool-note h2 { margin: var(--sp-2) 0 var(--sp-4); font-family: var(--serif); font-size: 1.35rem; line-height: 1.35; }
  .tool-note > p:not(.eyebrow) { color: var(--ink2); }
  .save-state { margin: var(--sp-7) 0 var(--sp-4); padding-top: var(--sp-5); border-top: 1px solid var(--line); }
  .state-row { display: flex; justify-content: space-between; margin-bottom: var(--sp-3); font-size: .85rem; }
  .save-state .progress-track span { width: 0; }
  .tool-form { display: grid; gap: var(--sp-5); }
  .tool-section { padding: var(--sp-7); border: 1px solid var(--line); border-radius: var(--r-l); background: var(--panel); box-shadow: 0 1px 0 rgba(255,255,255,.02); }
  .tool-section h2 { margin: 0 0 var(--sp-2); font-family: var(--serif); }
  .tool-section > p { margin-top: 0; color: var(--ink2); }
  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-5); }
  .field { display: grid; gap: var(--sp-2); }
  .field.full { grid-column: 1 / -1; }
  .field label { color: var(--ink); font-weight: 760; }
  .field small { color: var(--ink3); }
  .tool-form input, .tool-form textarea, .tool-form select, .output-panel textarea {
    width: 100%; border: 1px solid var(--line); border-radius: var(--r-m); padding: var(--sp-4) var(--sp-5); background: var(--panel-deep); color: var(--ink); font: inherit;
  }
  .tool-form textarea { min-height: 118px; resize: vertical; }
  .tool-form input:focus, .tool-form textarea:focus, .tool-form select:focus { border-color: var(--accent); box-shadow: var(--glow); outline: 0; }
  .tool-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .output-panel { margin-top: var(--sp-6); padding: var(--sp-7); border: 1px solid var(--line-strong); border-radius: var(--r-l); background: var(--panel-deep); color: var(--ink); box-shadow: var(--shadow); }
  .output-panel h2 { margin-top: 0; font-family: var(--serif); }
  .output-panel textarea { min-height: 360px; font-family: var(--mono); font-size: .9rem; }
  .tool-status { min-height: 1.5em; color: var(--accent-light); }
  @media (max-width: 820px) {
    .tool-hero-grid, .tool-layout { grid-template-columns: 1fr; }
    .tool-note { position: static; }
    .field-grid { grid-template-columns: 1fr; }
  }
</style>
