---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['文章', `${base}/articles/`],
  ['主题', `${base}/themes/`],
  ['三部曲', `${base}/#trilogy`],
  ['关于', `${base}/about/`],
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={`${base}/`} aria-label="原力战略首页">原力战略</a>
    <nav aria-label="主导航">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(18px); background: rgba(246,241,232,.84); border-bottom: 1px solid rgba(217,208,195,.8); }
  .nav { min-height: 66px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { font-family: Georgia, "Noto Serif SC", serif; font-weight: 800; font-size: 1.15rem; }
  nav { display: flex; gap: 18px; font-size: .92rem; }
  @media (max-width: 520px) { nav a:nth-child(3), nav a:nth-child(4) { display: none; } }
</style>
