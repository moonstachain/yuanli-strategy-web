---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const links = [
  { label: '前哨', href: `${base}/columns/observation/`, match: '/columns/observation/' },
  { label: '商业物种', href: `${base}/columns/business-species/`, match: '/columns/business-species/' },
  { label: '诊断室', href: `${base}/columns/diagnosis/`, match: '/columns/diagnosis/' },
  { label: 'OS实验室', href: `${base}/columns/os-lab/`, match: '/columns/os-lab/' },
  { label: '工具', href: `${base}/tools/`, match: '/tools/' },
  { label: '正典', href: `${base}/columns/canon/`, match: '/columns/canon/' },
];
const isActive = (match: string) => currentPath.includes(match);
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={`${base}/`} aria-label="原力战略首页">
      <span class="brand-mark" aria-hidden="true">原</span>
      <span>原力战略</span>
      <small>前沿战略媒体</small>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a class="nav-link" href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary aria-label="打开导航菜单"><span aria-hidden="true">菜单</span></summary>
      <nav class="mobile-panel" aria-label="移动端主导航">
        <p class="eyebrow">从变化进入行动</p>
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>{link.label}<span aria-hidden="true">→</span></a>
        ))}
        <a href={`${base}/about/`}>关于原力战略<span aria-hidden="true">→</span></a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-nav); border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent); background: color-mix(in srgb, var(--bg) 86%, transparent); -webkit-backdrop-filter: blur(16px) saturate(1.25); backdrop-filter: blur(16px) saturate(1.25); }
  .nav-shell { min-height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); }
  .brand { display: inline-flex; align-items: center; gap: var(--sp-3); font-family: var(--serif); font-weight: 800; letter-spacing: .02em; }
  .brand:hover { color: var(--ink); }
  .brand small { color: var(--ink3); font-family: var(--sans); font-size: .68rem; font-weight: 700; letter-spacing: .08em; }
  .brand-mark { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--accent); border-radius: 50%; color: var(--accent); font-size: .8rem; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(10px, 1.5vw, 20px); }
  .nav-link { position: relative; padding: 22px 0 19px; color: var(--ink2); font-size: .88rem; }
  .nav-link::after { content: ''; position: absolute; right: 0; bottom: 13px; left: 0; height: 1px; transform: scaleX(0); background: var(--accent); transition: transform var(--dur-1) var(--ease); }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--ink); }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { list-style: none; padding: var(--sp-2) var(--sp-4); border: 1px solid var(--line); border-radius: var(--r-pill); cursor: pointer; font-size: .84rem; font-weight: 760; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-panel { position: absolute; top: calc(100% + var(--sp-3)); right: 0; width: min(340px, calc(100vw - 32px)); padding: var(--sp-6); border: 1px solid var(--line); border-radius: var(--r-l); background: var(--panel-deep); box-shadow: var(--shadow); }
  .mobile-panel a { display: flex; align-items: center; justify-content: space-between; padding: var(--sp-4) 0; border-bottom: 1px solid var(--line); color: var(--ink2); font-family: var(--serif); font-size: 1.15rem; }
  .mobile-panel a:last-child { border-bottom: 0; }
  .mobile-panel a[aria-current='page'] { color: var(--accent); }
  @media (max-width: 980px) { .brand small { display: none; } }
  @media (max-width: 820px) { .desktop-nav { display: none; } .mobile-menu { display: block; } }
</style>
