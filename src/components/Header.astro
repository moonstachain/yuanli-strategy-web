---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const currentPathParam = Astro.url.searchParams.get('path');
const currentArticleType = Astro.url.searchParams.get('type');

const userLinks = [
  { key: 'era', label: '看时代', href: `${base}/columns/observation/` },
  { key: 'A', label: '找原力', href: `${base}/start/?path=A` },
  { key: 'B', label: '做生意', href: `${base}/start/?path=B` },
  { key: 'C', label: '建系统', href: `${base}/start/?path=C` },
  { key: 'articles', label: '文章', href: `${base}/articles/` },
  { key: 'cases', label: '案例', href: `${base}/articles/?type=case` },
  { key: 'tools', label: '工具', href: `${base}/tools/` },
  { key: 'canon', label: '正典', href: `${base}/columns/canon/` },
];

const isActive = (key: string) => {
  if (key === 'era') return currentPath.includes('/columns/observation/');
  if (key === 'A' || key === 'B' || key === 'C') {
    return currentPath.includes('/start/') && currentPathParam === key;
  }
  if (key === 'articles') return currentPath.includes('/articles/') && currentArticleType !== 'case';
  if (key === 'cases') return currentPath.includes('/articles/') && currentArticleType === 'case';
  if (key === 'tools') return currentPath.includes('/tools/');
  if (key === 'canon') return currentPath.includes('/columns/canon/');
  return false;
};
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={`${base}/`} aria-label="原力战略首页">
      <span class="brand-mark" aria-hidden="true">原</span>
      <span>原力战略</span>
    </a>

    <nav class="desktop-nav" aria-label="用户主导航">
      {userLinks.map((link) => (
        <a class="nav-link" href={link.href} aria-current={isActive(link.key) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary aria-label="打开导航菜单"><span aria-hidden="true">菜单</span></summary>
      <nav class="mobile-panel" aria-label="移动端用户主导航">
        <p class="eyebrow">我来这里做什么</p>
        {userLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.key) ? 'page' : undefined}>
            {link.label}<span aria-hidden="true">→</span>
          </a>
        ))}
        <div class="mobile-about">
          <a href={`${base}/about/`}>关于我们如何工作<span aria-hidden="true">→</span></a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-nav); border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent); background: color-mix(in srgb, var(--bg) 88%, transparent); -webkit-backdrop-filter: blur(16px) saturate(1.2); backdrop-filter: blur(16px) saturate(1.2); }
  .nav-shell { min-height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: var(--sp-3); font-family: var(--serif); font-weight: 800; letter-spacing: .02em; }
  .brand:hover { color: var(--ink); }
  .brand-mark { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--accent); border-radius: 50%; color: var(--accent); font-size: .8rem; }
  .desktop-nav { display: flex; min-width: 0; align-items: center; justify-content: flex-end; gap: clamp(8px, 1.05vw, 17px); }
  .nav-link { position: relative; padding: 22px 0 19px; color: var(--ink2); font-size: clamp(.78rem, .9vw, .88rem); white-space: nowrap; }
  .nav-link::after { content: ''; position: absolute; right: 0; bottom: 13px; left: 0; height: 1px; transform: scaleX(0); background: var(--accent); transition: transform var(--dur-1) var(--ease); }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--ink); }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { list-style: none; padding: var(--sp-2) var(--sp-4); border: 1px solid var(--line); border-radius: var(--r-pill); cursor: pointer; font-size: .84rem; font-weight: 760; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-panel { position: absolute; top: calc(100% + var(--sp-3)); right: 0; width: min(350px, calc(100vw - 32px)); max-height: calc(100vh - 96px); overflow-y: auto; padding: var(--sp-6); border: 1px solid var(--line); border-radius: var(--r-l); background: var(--panel-deep); box-shadow: var(--shadow); }
  .mobile-panel > a, .mobile-about a { display: flex; align-items: center; justify-content: space-between; padding: var(--sp-4) 0; border-bottom: 1px solid var(--line); color: var(--ink2); font-family: var(--serif); font-size: 1.08rem; }
  .mobile-panel a[aria-current='page'] { color: var(--accent); }
  .mobile-about { margin-top: var(--sp-6); padding-top: var(--sp-2); border-top: 1px solid var(--line-strong); }
  .mobile-about a { border-bottom: 0; font-family: var(--sans); font-size: .9rem; }
  @media (max-width: 1120px) { .desktop-nav { display: none; } .mobile-menu { display: block; } }
</style>
